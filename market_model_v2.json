{
  "version": "MARKET-MODEL-V2-PRUNED20-2026-09-23",
  "intent": "Mean-reversion oriented market-state monitor. Keep the voting layer compact and independent; redundant composites and slow/context factors remain observable without double-counting in the score.",
  "bucket_weights": {
    "short_market": 0.4,
    "sentiment_event": 0.25,
    "long_structure": 0.2,
    "macro": 0.15
  },
  "horizon_definition": {
    "short_market": "1–10 trading days",
    "sentiment_event": "1–5 trading days with rapid decay unless price/credit reaction persists",
    "long_structure": "20–120 trading days",
    "macro": "1–4 quarters; daily market-price proxies may update faster"
  },
  "transition_policy": {
    "note": "Low-frequency official releases can move the level/state, but are not allowed to create synthetic daily D1/D2 transition momentum while values are merely carried forward.",
    "traffic_confirmation": "Use two consecutive closes beyond a boundary, or a single overshoot of >=3 score points, before treating a color change as structurally confirmed.",
    "structural_transition_window": "Typical score-color episodes are measured empirically and reported daily; do not hard-code a fixed cycle length."
  },
  "pruning_policy": {
    "principle": "An indicator must add distinct information to keep a vote. Derived composites, duplicate volatility/fear chains, no-direction factors and slow background series are moved to Context or Archive rather than deleted from the data pool.",
    "ablation": "Leave-one-out ablation uses both full-history and a 2022-present chronological holdout. Automatic removal requires OOS support or extreme same-bucket redundancy; results remain exploratory because reconstructed history is not fully point-in-time.",
    "last_structural_prune": "2026-09-23",
    "last_oos_prune": [
      "quant_crowding",
      "cross_asset_correlation",
      "rate_cycle_sensitivity",
      "credit_cycle"
    ]
  },
  "active": [
    {"id":"market_support","bucket":"short_market","multiplier":1.25,"transition_driver":true},
    {"id":"money_making_effect","bucket":"short_market","multiplier":1.15,"transition_driver":true},
    {"id":"market_overextension","bucket":"short_market","multiplier":1.0,"transition_driver":true},
